# Server
NODE_ENV=development
PORT=8801
# Set this to your deployed frontend URL in production (used for CORS).
CLIENT_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/retake?retryWrites=true&w=majority

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=change-me-access-secret  
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# WhatsApp Meta Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_PHONE_NUMBER2_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_URL=https://graph.facebook.com/v22.0

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=info@devaditya.dev
