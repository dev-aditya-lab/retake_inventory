# Server
NODE_ENV=development
PORT=8801
# Set this to your deployed frontend URL in production (used for CORS).
CLIENT_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/retake?retryWrites=true&w=majority

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=change-me-access-secret  
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# WhatsApp Meta Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_PHONE_NUMBER2_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_URL=https://graph.facebook.com/v22.0
# Inbound webhook: callback URL is https://<backend-host>/webhooks/whatsapp
# Verify token: any random string (NOT the access token), pasted into Meta's webhook settings.
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
WHATSAPP_VERIFY_TOKEN=
# Meta app secret (App settings -> Basic). Requests without a valid signature are rejected.
WHATSAPP_APP_SECRET=
# All of the WhatsApp values above can also be entered in the app (WhatsApp > Settings, admin only);
# what is saved there wins, and these act as the fallback. Saved tokens are encrypted with this key
# (falls back to JWT_REFRESH_SECRET). Set it once to a long random string and never change it.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WHATSAPP_SETTINGS_KEY=
# Staff sign in with a one-time code (no passwords). It is sent to the staff member's WhatsApp with this
# approved AUTHENTICATION template (body: the code as {{1}}, plus a "copy code" button), and by email
# (Resend) when WhatsApp can't deliver. These are the defaults; change them only if yours differ.
WHATSAPP_OTP_TEMPLATE=otp_auth_01
WHATSAPP_OTP_LANGUAGE=en_US

# Web Push notifications (PWA). Needs `npm install web-push` in /backend.
# Generate once:  npx web-push generate-vapid-keys   (keep the private key secret)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@devaditya.dev

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=info@devaditya.dev
